Aim:To write a Java program to calculate the sum of similarities of a given string with all of its suffixes using the Z-algorithm.
Program:import java.io.*;

public class Solution {

    public static long calculateSimilarity(String s) {
        int n = s.length();
        int[] z = new int[n];

        z[0] = n;

        int left = 0;
        int right = 0;

        for (int i = 1; i < n; i++) {

            if (i <= right) {
                z[i] = Math.min(right - i + 1, z[i - left]);
            }

            while (i + z[i] < n &&
                   s.charAt(z[i]) == s.charAt(i + z[i])) {
                z[i]++;
            }

            if (i + z[i] - 1 > right) {
                left = i;
                right = i + z[i] - 1;
            }
        }

        long sum = 0;

        for (int i = 0; i < n; i++) {
            sum += z[i];
        }

        return sum;
    }

    public static void main(String[] args) throws IOException {

        BufferedReader br =
                new BufferedReader(new InputStreamReader(System.in));

        int t = Integer.parseInt(br.readLine().trim());

        StringBuilder output = new StringBuilder();

        while (t-- > 0) {
            String s = br.readLine().trim();

            output.append(calculateSimilarity(s))
                  .append('\n');
        }

        System.out.print(output);
    }
}
